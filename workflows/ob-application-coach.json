      "parameters": {
        "toolDescription": "  Writes a tailored, professional cover letter based on the candidate CV and job description.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "  You are a Cover Letter Writer. Write a concise, persuasive, tailored cover letter (max 250 words) using the candidate's real experience. Do not invent facts."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        352,
        224
